[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/zombie_rounds.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/zombie_textured.tscn" id="2_zombie"]

[sub_resource type="SceneReplicationConfig" id="SceneReplicationConfig_sync"]
properties/0/path = NodePath(".:round_number")
properties/0/spawn = true
properties/0/replication_mode = 2
properties/1/path = NodePath(".:fighting")
properties/1/spawn = true
properties/1/replication_mode = 2
properties/2/path = NodePath(".:zombies_left")
properties/2/spawn = true
properties/2/replication_mode = 2
properties/3/path = NodePath(".:seconds_left")
properties/3/spawn = true
properties/3/replication_mode = 2

[node name="ZombieRounds" type="Node3D" groups=["rounds"]]
script = ExtResource("1_script")
zombie_scene = ExtResource("2_zombie")

[node name="Sync" type="MultiplayerSynchronizer" parent="."]
replication_config = SubResource("SceneReplicationConfig_sync")
